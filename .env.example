# Copy to .env and adjust. Names match app/config.py Settings.

# Database URL. Default: local SQLite file.
DATABASE_URL=sqlite:///./ilanuyum.db
# PostgreSQL example (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://ilanuyum:ilanuyum@localhost:5432/ilanuyum

# Secret used to sign JWTs. CHANGE IT in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=dev-secret-change-me

# JWT signing algorithm.
ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CV <-> job posting match analysis (optional) ---
# Without an API key for the selected provider, POST /applications/{id}/match returns 503.
LLM_PROVIDER=anthropic
# Leave empty for the default model of the provider (anthropic: claude-haiku-5-5, openai: gpt-4o-mini).
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
